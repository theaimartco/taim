<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- taim::platform::vibrate needs this; remove it if the app never vibrates. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      The activity is TAIM's host, com.theaimartco.taim.TaimActivity (a
      NativeActivity, copied into app/src/main/java): it loads lib{{lib}}.so,
      calls its `android_main`, and connects the native editor, insets,
      TalkBack, back navigation and platform services.

      configChanges keeps the activity (and the application's state) alive
      across rotation, resizing, a hardware keyboard and a dark-mode switch;
      TAIM lays out again and follows the new theme.

      adjustResize lets the on-screen keyboard shrink the content area, which
      TAIM reads as an inset so a focused text field stays visible.
    -->
    <application
        android:label="{{name}}"
        android:hasCode="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name="com.theaimartco.taim.TaimActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="android.app.lib_name"
                android:value="{{lib}}" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
